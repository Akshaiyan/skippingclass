# Copy to .env.local (git-ignored via *.local). All optional.

# Dev only: where `npm run dev` forwards /api/*. Default http://127.0.0.1:8000 (python server.py).
# Point at a teammate's machine or a deployed backend to develop against it.
# VITE_PROXY_TARGET=http://127.0.0.1:8000

# Build time: call the backend directly instead of same-origin /api. Needs CORS on the backend
# (server.py already sends Access-Control-Allow-Origin: *). Leave unset when the host rewrites /api/*.
# VITE_API_BASE=https://your-backend.example.com
